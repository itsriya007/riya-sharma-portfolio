# ===================================================================
# Riya Sharma Portfolio - Environment Variables Configuration
# ===================================================================

# Server Port
PORT=3000

# Environment Mode: development | production
NODE_ENV=development

# Primary recipient for portfolio contact form inquiries
RECIPIENT_EMAIL=riya0077224@gmail.com

# -------------------------------------------------------------------
# SMTP / EMAIL CONFIGURATION (Nodemailer)
# -------------------------------------------------------------------
# Option A: Using Gmail with an App Password (Recommended)
# 1. Go to your Google Account -> Security -> 2-Step Verification (turn ON if not already)
# 2. Under 2-Step Verification, scroll down to "App passwords"
# 3. Create an app password named "Portfolio Website"
# 4. Paste your Gmail address in SMTP_USER and the generated 16-char password in SMTP_PASS
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=riya0077224@gmail.com
SMTP_PASS=your_16_character_app_password_here

# Option B: Using Custom SMTP (SendGrid, Mailgun, AWS SES, Brevo, etc.)
# Uncomment and fill if you prefer standard SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
